{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Namaste Tripathi",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_PUBLISHABLE_KEY_HERE",
        "--dart-define=GOOGLE_SERVER_CLIENT_ID=PASTE_YOUR_WEB_CLIENT_ID.apps.googleusercontent.com",
        "--dart-define=GOOGLE_IOS_CLIENT_ID=PASTE_YOUR_IOS_CLIENT_ID.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Namaste Tripathi (demo backend, no Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ]
}
